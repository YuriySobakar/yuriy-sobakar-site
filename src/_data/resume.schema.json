{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yuriy-sobakar.netlify.app/resume.schema.json",
  "title": "Resume data",
  "description": "Contract for src/_data/resume.yaml — the single source of every text shown on the site. A new field is added HERE first, then in the YAML.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "headline", "facts", "contacts", "sections", "experience", "skills", "projects"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "description": "Owner's full name; becomes the page <h1> and <title>." },
    "headline": { "type": "string", "minLength": 1, "maxLength": 120, "description": "Positioning: one sentence under the name — who the owner is and for whom." },
    "photo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "alt", "width", "height"],
      "description": "Optional portrait on the hero. src is a site path under /assets/; width/height are the intrinsic pixels (layout stability).",
      "properties": {
        "src": { "type": "string", "pattern": "^/assets/[A-Za-z0-9._-]+$" },
        "alt": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1, "maxLength": 60 },
      "description": "1–3 short verifiable statements shown on the first screen."
    },
    "contacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/contact" }
    },
    "sections": {
      "type": "array",
      "description": "Order and headings of the page sections below the hero. Each id maps to src/_includes/sections/<id>.njk.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "enum": ["experience", "skills", "projects", "education", "contacts"] },
          "title": { "type": "string", "minLength": 1 }
        }
      }
    },
    "experience": {
      "type": "array",
      "items": { "$ref": "#/definitions/experienceEntry" }
    },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/definitions/skillGroup" }
    },
    "projects": {
      "type": "array",
      "items": { "$ref": "#/definitions/project" }
    },
    "education": {
      "type": "array",
      "description": "Optional; shown newest-first like experience. Omit for no Education section.",
      "items": { "$ref": "#/definitions/educationEntry" }
    }
  },
  "definitions": {
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label", "url"],
      "properties": {
        "type": { "type": "string", "enum": ["email", "telegram", "linkedin", "phone", "github", "website"] },
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1, "description": "mailto:, tel:, or https:// URL" }
      }
    },
    "experienceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "company", "start"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "company": { "type": "string", "minLength": 1 },
        "location": { "type": "string" },
        "start": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$", "description": "YYYY-MM" },
        "end": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$", "description": "YYYY-MM; omit for the current position" },
        "results": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "stack": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "educationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["school", "program", "start"],
      "properties": {
        "school": { "type": "string", "minLength": 1 },
        "program": { "type": "string", "minLength": 1, "description": "Degree, course or certificate name" },
        "location": { "type": "string" },
        "start": { "type": "string", "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2]))?$", "description": "YYYY-MM, or YYYY when only the year matters" },
        "end": { "type": "string", "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2]))?$", "description": "YYYY-MM or YYYY; omit while ongoing; equal to start = shown once" }
      }
    },
    "skillGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "items"],
      "properties": {
        "group": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "description": "A skill is a string, or {label, url} when it should link to proof (a certificate, a profile).",
          "items": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "url"],
                "properties": {
                  "label": { "type": "string", "minLength": 1 },
                  "url": { "type": "string", "pattern": "^https://" }
                }
              }
            ]
          }
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "role", "result"],
      "properties": {
        "kind": { "type": "string", "enum": ["commercial", "pet", "open-source"], "description": "commercial: client work, code never linked; pet: own project with code; open-source: former client work whose code is published with permission" },
        "confidential": { "type": "boolean", "default": false },
        "name": { "type": "string", "minLength": 1 },
        "industry": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "result": { "type": "string", "minLength": 1 },
        "stack": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "live": { "type": "string", "minLength": 1 },
            "code": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
