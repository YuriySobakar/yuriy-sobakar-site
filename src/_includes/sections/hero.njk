{#- SCR-02 hero: name, positioning, 1–3 facts (fact-list), contact buttons — all above the fold at 360×640.
    Facts (≥1) and contacts (≥1) are guaranteed by the schema; the photo is the one optional field (schema `photo`).
    "Print" (roadmap step 5, ADR 0004; the browser dialog also saves a PDF) is the single window.print() handler allowed by the conventions;
    it is template UI, hidden on paper via .no-print. -#}
<header class="hero section" id="top">
  {#- Share (ADR 0005): Web Share API on phones, copy-link fallback on desktop; handler in layout.njk.
      Icon-only on mobile (label is visually hidden), icon + label from 768 px. Hidden on paper. -#}
  <button type="button" class="button button--ghost hero__share no-print" data-share aria-label="Share this resume">{% include "icons/share.njk" %}<span class="hero__share-label">Share</span></button>
  <div class="hero__top">
    {%- if resume.photo %}
    <img class="hero__photo" src="{{ resume.photo.src }}" alt="{{ resume.photo.alt }}" width="{{ resume.photo.width }}" height="{{ resume.photo.height }}" fetchpriority="high" decoding="async">
    {%- endif %}
    <div class="hero__intro">
      <h1 class="hero__name">{{ resume.name }}</h1>
      <p class="hero__headline">{{ resume.headline }}</p>
    </div>
  </div>
  <ul class="fact-list">
    {%- for fact in resume.facts %}
    <li>{{ fact }}</li>
    {%- endfor %}
  </ul>
  <ul class="hero__contacts">
    {%- for contact in resume.contacts %}
    <li>{% include "contact-button.njk" %}</li>
    {%- endfor %}
    <li class="hero__print"><button type="button" class="button button--ghost no-print" onclick="window.print()">{% include "icons/print.njk" %}<span>Print</span></button></li>
  </ul>
</header>
