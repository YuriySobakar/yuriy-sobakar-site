{#- SCR-02 hero: name, positioning, 1–3 facts (fact-list), contact buttons — all above the fold at 360×640.
    Facts (≥1) and contacts (≥1) are guaranteed by the schema; the photo is the one optional field (schema `photo`).
    "Print" and "Share" are template UI in .hero__actions (see below), hidden on paper via .no-print. -#}
<header class="hero section" id="top">
  <div class="hero__top">
    {%- if resume.photo %}
    <img class="hero__photo" src="{{ resume.photo.src }}" alt="{{ resume.photo.alt }}" width="{{ resume.photo.width }}" height="{{ resume.photo.height }}" fetchpriority="high" decoding="async">
    {%- endif %}
    <div class="hero__intro">
      <h1 class="hero__name">{{ resume.name }}</h1>
      <ul class="hero__headline">
        {%- for line in resume.headlineLines %}
        <li>{{ line }}</li>
        {%- endfor %}
      </ul>
    </div>
  </div>
  <ul class="fact-list">
    {%- for fact in resume.facts %}
    <li>{{ fact }}</li>
    {%- endfor %}
  </ul>
  <ul class="hero__contacts">
    {%- for contact in resume.contacts %}
    <li>{% include "contact-button.njk" %}</li>
    {%- endfor %}
  </ul>
  {#- Actions (Share — ADR 0005, Web Share API with a clipboard fallback, handler in layout.njk;
      Print — ADR 0004, the single window.print() handler allowed by the conventions).
      One grid item of .hero (grid-template-areas in base.css / layout.css): on mobile two full-width
      rows under the contacts, from 768 px a column in the top-right cell beside hero__top.
      One DOM node per button for both layouts, no absolute positioning. Hidden on paper. -#}
  <div class="hero__actions no-print">
    <button type="button" class="button button--ghost hero__share no-print" data-share aria-label="Share this resume">{% include "icons/share.njk" %}<span class="hero__share-label">Share</span></button>
    <button type="button" class="button button--ghost no-print" onclick="window.print()">{% include "icons/print.njk" %}<span>Print</span></button>
  </div>
</header>
