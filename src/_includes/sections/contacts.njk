{#- SCR-06 contacts (footer): one same-tab button per contact type, with icon; data-contact feeds the click
    counter in layout.njk (ADR 0003). At least one contact is guaranteed by the schema. -#}
<section class="section" id="{{ section.id }}" aria-labelledby="{{ section.id }}-title">
  <h2 class="section__title" id="{{ section.id }}-title">{{ section.title }}</h2>
  <ul class="contacts">
    {%- for contact in resume.contacts %}
    <li>{% include "contact-button.njk" %}</li>
    {%- endfor %}
  </ul>
</section>
