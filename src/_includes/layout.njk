<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ resume.name }} — {{ resume.headline }}</title>
  <meta name="description" content="{{ resume.headline }}">
  {#- Preloads: the font and the portrait are the two above-the-fold resources that would otherwise
      arrive after CSS and shift the hero (spec AC-01 / NFR performance). -#}
  <link rel="preload" href="/assets/fonts/montserrat-en.woff2" as="font" type="font/woff2" crossorigin>
  {%- if resume.photo %}
  <link rel="preload" href="{{ resume.photo.src }}" as="image">
  {%- endif %}
  <link rel="stylesheet" href="/styles/tokens.css">
  <link rel="stylesheet" href="/styles/base.css">
  <link rel="stylesheet" href="/styles/layout.css">
  <link rel="stylesheet" href="/styles/print.css" media="print">
</head>
<body>
  <div class="page">
    {{ content | safe }}
  </div>
  {%- if site.counter.script %}
  {#- Contact click counter (ADR 0003): the ONLY client-side JavaScript besides window.print().
      One async tag + one delegated click handler; no cookies, no visitor ids, never blocks navigation.
      Disabled (no <script> at all) when site.json leaves counter.script empty. -#}
  <script async src="{{ site.counter.script }}" data-goatcounter="{{ site.counter.endpoint }}"></script>
  <script>
    document.addEventListener("click", function (event) {
      var link = event.target.closest("a[data-contact]");
      if (!link || !window.goatcounter || typeof window.goatcounter.count !== "function") return;
      window.goatcounter.count({ path: "contact:" + link.getAttribute("data-contact"), event: true });
    });
  </script>
  {%- endif %}
</body>
</html>
